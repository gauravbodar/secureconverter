# ─────────────────────────────────────────────────────────────
# Bank Statement Converter — Environment Variables
# Copy this file to .env (never commit .env to git)
# Set these in Vercel project settings for production
# ─────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SECRET=your_supabase_service_role_key

# ── MailerLite ────────────────────────────────────────────────
MAILERLITE_API_KEY=mlsn_your_api_key
MAILERLITE_GROUP_ID=your_group_id

# ── Authentication ────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_min_32_chars

# ── Stripe ───────────────────────────────────────────────────
STRIPE_PUBLIC_KEY=pk_test_or_live_xxx
STRIPE_SECRET_KEY=sk_test_or_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_PRO_MONTHLY=price_xxx   # Create in Stripe dashboard
STRIPE_PRICE_PRO_YEARLY=price_xxx    # Create in Stripe dashboard

# ── App Config ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://securestatementconverter.com
NODE_ENV=production

# ── Frontend (Vite — VITE_ prefix required) ───────────────────
# These are embedded in the browser bundle at build time.
# Only use for non-sensitive, public values.
VITE_MAILERLITE_API_KEY=mlsn_your_api_key   # waitlist form calls API directly
VITE_MAILERLITE_GROUP_ID=your_group_id
